{
  "name": "dead-road-404",
  "private": true,
  "version": "0.21.6",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run test && npm run build",
    "smoke": "node scripts/smoke-browser.mjs",
    "qa:finales": "node scripts/qa-finales31.mjs",
    "qa:stability": "node scripts/qa-stability32.mjs",
    "qa:visual": "node scripts/qa-visual33.mjs",
    "benchmark:gpu": "npm run build && node scripts/benchmark-gpu.mjs",
    "benchmark:ci": "node scripts/benchmark-gpu.mjs --headless --swiftshader --seconds=3 --repeats=1"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "@types/three": "^0.180.0",
    "playwright": "^1.56.1"
  }
}
